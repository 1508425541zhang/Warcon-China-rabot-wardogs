ARG RUST_IMAGE=rust:1.98.1-bookworm
FROM oven/bun:1.4.2 AS presentation-metadata
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts --production
COPY src/lib/causes.ts ./src/lib/causes.ts
COPY src/lib/plugins ./src/lib/plugins
COPY backend/tools/export-presentation-catalog.ts ./backend/tools/
RUN mkdir -p backend/assets && bun backend/tools/export-presentation-catalog.ts

FROM ${RUST_IMAGE} AS native-build
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/Cargo.toml backend/Cargo.lock ./backend/
RUN cd backend && cargo fetch --locked
COPY backend ./backend
COPY --from=presentation-metadata /app/backend/assets/ ./backend/assets/
COPY services/integrity-model-bun ./services/integrity-model-bun
COPY services/short-risk/artifacts-rust ./services/short-risk/artifacts-rust
RUN cargo build --manifest-path backend/Cargo.toml --locked --release --bins --jobs 2

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 libgcc-s1 && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home warcon
WORKDIR /app
COPY --from=native-build /app/backend/target/release/warcon-api /app/backend/target/release/warcon-worker /app/backend/target/release/warcon-model /app/backend/target/release/warcon-health /app/backend/target/release/migrate /app/backend/target/release/reset-auth /usr/local/bin/
COPY drizzle ./drizzle
COPY services/short-risk/artifacts-rust ./short
COPY services/integrity-model-bun/artifacts-30m ./model-27
USER warcon
ARG WARCON_COMMIT=""
ENV WARCON_COMMIT=$WARCON_COMMIT
ENV RUST_BACKEND_BIND=0.0.0.0:4300 RUST_WORKER_BIND=0.0.0.0:7700 RUST_LOG=warcon_backend=info
EXPOSE 4300 7700 8091
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD ["warcon-health", "http://127.0.0.1:4300/api/health"]
CMD ["warcon-api"]
