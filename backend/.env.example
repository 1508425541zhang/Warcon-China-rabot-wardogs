# Development only. Never use the production database for migration contract tests.
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/warcon_rust_dev
TEST_DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/postgres
RUST_BACKEND_BIND=127.0.0.1:4300
ORIGIN=http://localhost:3000
# Supply the same values as the isolated Svelte development instance for interoperability.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
# The migrated profile/playtime worker uses this optional external credential.
STEAM_API_KEY=
MODEL_ARTIFACTS_DIR=/path/to/expanded30m/artifacts
MODEL_DATABASE_URL=postgresql://readonly-user:replace-me@127.0.0.1:5432/warcon_rust_dev
MODEL_API_TOKEN=replace-with-at-least-32-random-characters
MODEL_HOST=127.0.0.1
MODEL_PORT=8091
