# Development only. Copy to .env.rust.dev and replace every placeholder.
ORIGIN=http://localhost:4302
POSTGRES_PASSWORD=replace-with-a-random-development-password
BETTER_AUTH_SECRET=replace-with-a-random-string-at-least-32-characters
ENCRYPTION_KEY=replace-with-a-random-base64-32-byte-key
RELAY_SECRET=replace-with-a-random-string-at-least-32-characters
RUST_FRONTEND_TOKEN=replace-with-another-random-string-at-least-32-characters
STEAM_API_KEY=
ALLOW_ORG_SIGNUP=false
WARCON_SHORT_RISK_ENABLED=0
# Optional long model profile: complete trained artifacts including weights and scaler.
MODEL_ARTIFACTS_PATH=./models/long
MODEL_API_TOKEN=replace-with-a-random-string-at-least-32-characters
