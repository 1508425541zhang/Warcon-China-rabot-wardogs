{
	"name": "warcon",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"description": "WARDOGS community server management: native Rust backend, SvelteKit UI, PostgreSQL and Docker.",
	"scripts": {
		"dev": "bun run prepare:backend && vite dev",
		"build": "bun run prepare:backend && vite build",
		"build:worker": "bun run prepare:backend && cargo build --manifest-path backend/Cargo.toml --release --bin warcon-worker",
		"worker": "cargo run --manifest-path backend/Cargo.toml --bin warcon-worker",
		"db:migrate": "cargo run --manifest-path backend/Cargo.toml --bin migrate -- drizzle",
		"auth:reset": "cargo run --manifest-path backend/Cargo.toml --bin reset-auth --",
		"start": "node build/index.js",
		"preview": "npm run build && node build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "bun test src/lib src/routes/page-loads.test.ts",
		"lint": "prettier --check . --end-of-line auto",
		"format": "prettier --write . --end-of-line auto",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"docs:plugins": "bun scripts/build-plugin-docs.ts",
		"backend:dev": "bun run prepare:backend && cargo run --manifest-path backend/Cargo.toml --bin warcon-api",
		"backend:test": "cargo test --manifest-path backend/Cargo.toml --locked -- --include-ignored",
		"prepare:backend": "bun backend/tools/export-presentation-catalog.ts"
	},
	"devDependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/barlow": "^5.3.0",
		"@fontsource/barlow-condensed": "^5.3.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"@types/qrcode": "^1.5.6",
		"drizzle-kit": "^0.31.10",
		"opentype.js": "^2.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.2"
	},
	"dependencies": {
		"@better-auth/passkey": "1.7.5",
		"@simplewebauthn/browser": "13",
		"better-auth": "1.7.5",
		"drizzle-orm": "^0.45.2",
		"prom-client": "15",
		"qrcode": "1",
		"zod": "4.5.4"
	},
	"engines": {
		"bun": ">=1.4.2 <1.5",
		"node": ">=22.12"
	}
}
