# Copy to .env for Compose. Direct Rust commands require exported environment variables.
# See docs/rust-development.zh-CN.md for the separate development stack.

# Required. Signs sessions: `openssl rand -base64 32` (this placeholder is refused at startup)
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# Required. Base64 of 32 random bytes; encrypts stored RCON passwords: `openssl rand -base64 32`
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Required: the exact URL people open (scheme, host, port). Form posts from any other origin are
# rejected, and cookies are marked Secure only when it starts with https://. `bun run dev` serves
# http://localhost:5173; Docker serves http://<host>:3000 or whatever your proxy fronts it with.
ORIGIN=http://localhost:3000
# Behind a proxy (Caddy, nginx, Traefik, Cloudflare Tunnel): the header it puts the client IP in.
# x-forwarded-for (XFF_DEPTH=1 reads the address your proxy appended), x-real-ip, or cf-connecting-ip.
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# Postgres connection. Docker Compose passes the bundled database as PGHOST/PGUSER/PGPASSWORD/PGDATABASE
# (from POSTGRES_PASSWORD), so nothing else is needed there. Set DATABASE_URL for direct Rust services or for an
# external database: it takes precedence, and a password containing / # % or ? must be percent-encoded in it.
# DATABASE_URL=postgres://warcon:warcon@127.0.0.1:5432/warcon
# Rust integration tests: a Postgres server the permission suites may create a throwaway warcon_rust_test_* database
# on for each run (never DATABASE_URL's own). Unset, those suites are skipped.
# TEST_DATABASE_URL=postgres://warcon:warcon@127.0.0.1:5434/postgres
POSTGRES_PASSWORD=change-me
# HTTP port (adapter-node). PORT=3000

# Optional
# SETUP_TOKEN=choose-a-one-time-setup-secret   # required by first-run owner setup when set
# STEAM_API_KEY=32hexchars                       # Steam lookups: persona, account age, VAC/game bans (dossiers, risk score, kick-on-connect)
# DISCORD_CLIENT_ID=                             # with DISCORD_CLIENT_SECRET: "Sign in with Discord" (invite links create accounts through it)
# DISCORD_CLIENT_SECRET=
# APP_NAME=Warcon China
# AUDIT_LOG_READS=false        # also audit read-only game calls (noisy)
# ALLOW_ORG_SIGNUP=false       # anyone may create an account and their own organisation at /sign-up
# MAX_ORGS_PER_USER=3          # self-serve cap; site owners are unlimited
# MAX_SERVERS_PER_ORG=10       # default per organisation; the site owner can raise it per org
# TURNSTILE_SITE_KEY=          # with TURNSTILE_SECRET_KEY: Cloudflare Turnstile on the password sign-up forms
# TURNSTILE_SECRET_KEY=
# ALLOW_DEMO_SERVER=true       # host "demo" + password "demo" hits the built-in mock game server
# GAME_TLS_INSECURE=false      # accept self-signed certificates on https game servers
# Rust API and Worker are separate processes; the Node service only renders/proxies pages.
RELAY_SECRET=change-me-to-32-random-characters   # shared by Rust API and Worker
# RELAY_URL=http://worker:7700 # Rust API: worker relay; keep empty in Worker itself
# RUST_BACKEND_BIND=127.0.0.1:4300
# RUST_WORKER_BIND=127.0.0.1:4301
# METRICS_TOKEN=               # Prometheus: bearer for GET /metrics on the web and worker; off when unset
# Observation cadences, delivery and retention are settings the owner edits in the panel (/settings).
# POLL_SECONDS=20              # seeds the analytics heartbeat on a fresh install only
# POLL_CONCURRENCY=128         # seeds the observation concurrency on a fresh install only
# Optional NapCat / LLBot OneBot 11 group bot. See docs/qq-community.zh-CN.md.
# Keep QQ_BOT_POLICIES identical on API and Worker; use real map IDs and numeric QQ group IDs.
# Prefer Site administration > QQ bot (/admin/qq); saved database settings override these defaults.
QQ_BOT_PROVIDER=napcat
ONEBOT_HTTP_URL=
ONEBOT_ACCESS_TOKEN=
ONEBOT_EVENT_SECRET=
ONEBOT_SELF_ID=
QQ_BOT_POLICIES=[]

# Rust backend branch: sign trusted frontend client-address forwarding.
RUST_FRONTEND_TOKEN=replace-with-another-random-string-at-least-32-characters
# Optional full trained long model artifacts. Enable Compose profile "model" only after preparing this directory.
MODEL_ARTIFACTS_PATH=./models/long
MODEL_API_TOKEN=
